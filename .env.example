# FlexOrder E2E Automation — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every required value in your .env
#   3. Never commit .env — it is gitignored
#
# EXECUTION MODES:
#   Local  → this `.env` file is loaded by src/config/environment.ts
#            (dotenv reads it at process start; CI is unset / false)
#   CI/CD  → variables are injected by .github/workflows/ci-workflow.yml
#            from GitHub Secrets. `CI=true` is set automatically by GitHub
#            Actions — do NOT add CI=true to your local .env
#
# SINGLE SOURCE OF TRUTH:
#   All code reads these values through `src/config/environment.ts`
#   (default export = validated `env` object). Never read process.env.*
#   directly in new code.
# ─────────────────────────────────────────────────────────────

# ── [REQUIRED] WordPress Site ─────────────────────────────────
# Local:    your test site URL (staging, Docker, whatever)
# CI:       set automatically to http://localhost:8080 by the workflow
SITE_URL=http://localhost:8080
# Optional override. If omitted, environment.ts computes
# `${SITE_URL}/wp-admin/` for you (trailing slash is handled safely).
# ADMIN_PANEL_URL=http://localhost:8080/wp-admin/

# ── [REQUIRED] Admin Credentials ──────────────────────────────
# Local:    values from your test WordPress admin user
# CI:       secrets.WORDPRESS_ADMIN_USER / secrets.WORDPRESS_ADMIN_PASSWORD
USER_NAME=admin
PASSWORD=your_admin_password

# ── [OPTIONAL] WooCommerce REST API ───────────────────────────
# Local:    generate manually — WooCommerce → Settings → Advanced →
#           REST API → Add Key (permissions: Read/Write)
# CI:       auto-generated by scripts/setup-ci-environment.ts and
#           written to tests/fixtures/api-keys.json. The workflow also
#           exports them as env vars for any direct process.env readers.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ── [OPTIONAL] FlexOrder Pro License ──────────────────────────
# Required only by Pro-gated specs (currently none wired in).
# CI:       secrets.FLEXORDER_PRO_LICENSE_KEY
FLEXORDER_PRO_LICENSE_KEY=

# ── [OPTIONAL] Google Sheets Integration ──────────────────────
# Required by:
#   tests/specs/update-order-status.spec.ts
#   tests/specs/ultimateSettings.spec.ts
#   tests/specs/flexorder-setup.spec.ts (wizard sync step)
# CI:       secrets.GOOGLE_SHEET_URL / secrets.SHEET_NAME
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit
SHEET_NAME=Orders

# Path to your Google service account JSON file (relative to project root).
# Download from: Google Cloud Console → IAM → Service Accounts → Keys.
# The service account must have Editor access to the target Google Sheet.
# CI:       provided as a file artifact by the pipeline.
SERVICE_ACCOUNT_UPLOAD_FILE=./tests/fixtures/upload_key.json

# Uncommon overrides (defaults are usually fine):
# GOOGLE_SHEET_SCOPES=https://www.googleapis.com/auth/spreadsheets
# SHEET_RANGE=Orders!A1:Z1000

# ── [OPTIONAL] Docker Database (only for local Docker runs) ───
# Must match docker-compose.fresh-wordpress.yml.
# Ignored when running against a hosted WordPress test site.
DB_HOST=127.0.0.1
DB_NAME=flexorder_test
DB_USER=flexorder_user
DB_PASSWORD=flexorder_pass

# ── [OPTIONAL] Playwright Debug Controls ──────────────────────
# Uncomment to override runtime defaults. None of these are needed in CI.

# Show the browser window instead of headless (local only)
# NON_HEADLESS=true

# Slow every Playwright action by N seconds (e.g. 0.5 = 500ms) — local debug
# SLOWMO=0.5

# Per-test timeout in seconds (defaults: 90 local, 120 CI)
# TIMEOUT_SECONDS=90

# Number of retries on test failure (defaults: 1 local, 2 CI)
# MAX_RETRIES=1

# Parallel worker count (default: 1 — sequential for DB/Sheet determinism)
# PARALLEL_WORKERS=1
