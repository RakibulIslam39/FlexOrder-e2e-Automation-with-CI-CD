# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
.npm
.yarn-integrity
.pnp.*

# ---------------------------------------------------------------------------
# Secrets & credentials (NEVER commit — contains real keys / tokens / cookies)
# ---------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Playwright auth storage state (logged-in session cookies)
tests/fixtures/.auth/
playwright/.auth/

# Service account / API key fixtures
tests/fixtures/api-keys.json
tests/fixtures/upload_key.json
tests/fixtures/*service-account*.json

# WordPress secrets
wp-config.php

# ---------------------------------------------------------------------------
# Test output, reports & traces
# ---------------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
flaky-tests/
coverage/
.nyc_output/
*.lcov

# ---------------------------------------------------------------------------
# Logs & runtime data
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.pid.lock
*.seed
.node_repl_history

# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
build/
dist/
*.tgz
*.tar.gz
*.zip

# ---------------------------------------------------------------------------
# Cache directories
# ---------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Framework-specific build output (kept for portability if ever added)
.next/
.nuxt/
.out/
.storybook-out/

# ---------------------------------------------------------------------------
# Temporary / scratch files
# ---------------------------------------------------------------------------
tmp/
temp/
memory.md

# ---------------------------------------------------------------------------
# IDE / editor / OS
# ---------------------------------------------------------------------------
# VSCode — share settings.json & extensions.json, ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains
.idea/

# Cursor session data (debug logs, agent transcripts, etc.)
.cursor/

# Vim / Emacs
*.swp
*.swo
*~

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
ehthumbs.db
Thumbs.db

# ---------------------------------------------------------------------------
# WordPress content (generated / not part of automation repo)
# ---------------------------------------------------------------------------
wp-content/uploads/
wp-content/cache/
wp-content/backup-db/
wp-content/backups/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/mu-plugins/
wp-content/wp-cache-config.php
wp-content/plugins/hello.php

# ---------------------------------------------------------------------------
# Docker / CI scratch
# ---------------------------------------------------------------------------
.dockerignore.bak
.github/workflows/*.yml.bak
